# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
MODEL_STRONG=claude-haiku-5-5
MODEL_CHEAP=claude-haiku-5-5
MODEL_LOCAL=claude-haiku-5-5
# Stop once this process's estimated spend passes this many USD.
MAX_SPEND_USD=2.00
GENERATION_CONCURRENCY=2
MONGO_URI=mongodb://localhost:27017
MONGO_DB=onlynerd
# Shared password sent as the X-Master-Password header. Empty disables the check (dev only).
MASTER_PASSWORD=
