  "components": {
    "schemas": {
      "AdvanceIn": {
        "properties": {
          "days": {
            "type": "integer",
            "title": "Days"
          }
        },
        "type": "object",
        "required": [
          "days"
        ],
        "title": "AdvanceIn"
      },
      "AdvanceOut": {
        "properties": {
          "now": {
            "type": "string",
            "format": "date-time",
            "title": "Now"
          },
          "due_now": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Due Now"
          },
          "next_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Kind"
          },
          "next_concept_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Concept Id"
          }
        },
        "type": "object",
        "required": [
          "now",
          "due_now"
        ],
        "title": "AdvanceOut"
      },
      "AnswerGraded": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "concept_id": {
            "type": "string",
            "title": "Concept Id"
          },
          "correct": {
            "type": "boolean",
            "title": "Correct"
          },
          "chosen_tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chosen Tag"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "question_id",
          "concept_id",
          "correct"
        ],
        "title": "AnswerGraded"
      },
      "AnswerIn": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "chosen_index": {
            "type": "integer",
            "title": "Chosen Index"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "question_id",
          "chosen_index"
        ],
        "title": "AnswerIn"
      },
      "AttemptResultOut": {
        "properties": {
          "graded": {
            "items": {
              "$ref": "#/components/schemas/AnswerGraded"
            },
            "type": "array",
            "title": "Graded"
          },
          "correct_indices": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Correct Indices"
          },
          "explanations": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Explanations"
          },
          "mastery": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Mastery"
          },
          "new_confirmed_misconceptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "New Confirmed Misconceptions"
          },
          "messages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Messages",
            "default": []
          },
          "next": {
            "$ref": "#/components/schemas/StepOut"
          }
        },
        "type": "object",
        "required": [
          "graded",
          "correct_indices",
          "explanations",
          "mastery",
          "new_confirmed_misconceptions",
          "next"
        ],
        "title": "AttemptResultOut"
      },
      "ConceptResearch": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed"
            ],
            "title": "Status",
            "default": "pending"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/Resource"
            },
            "type": "array",
            "title": "Resources",
            "default": []
          }
        },
        "type": "object",
        "title": "ConceptResearch"
      },
      "ConceptState": {
        "properties": {
          "concept_id": {
            "type": "string",
            "title": "Concept Id"
          },
          "p_mastery": {
            "type": "number",
            "title": "P Mastery",
            "default": 0.2
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts",
            "default": 0
          },
          "failed_rounds": {
            "type": "integer",
            "title": "Failed Rounds",
            "default": 0
          },
          "stability_days": {
            "type": "number",
            "title": "Stability Days",
            "default": 0.0
          },
          "last_reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Reviewed At"
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "lapses": {
            "type": "integer",
            "title": "Lapses",
            "default": 0
          },
          "explanations_tried": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Explanations Tried",
            "default": []
          },
          "fallbacks": {
            "type": "integer",
            "title": "Fallbacks",
            "default": 0
          },
          "needs_help": {
            "type": "boolean",
            "title": "Needs Help",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "concept_id"
        ],
        "title": "ConceptState"
      },
      "CreateCourseIn": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "level": {
            "type": "string",
            "enum": [
              "novice",
              "beginner",
              "intermediate",
              "advanced"
            ],
            "title": "Level",
            "default": "beginner"
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "CreateCourseIn"
      },
      "CreateCourseOut": {
        "properties": {
          "course_id": {
            "type": "string",
            "title": "Course Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "topic": {
            "type": "string",
            "title": "Topic",
            "default": ""
          },
          "concepts": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Concepts",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "course_id",
          "status"
        ],
        "title": "CreateCourseOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Lesson": {
        "properties": {
          "concept_id": {
            "type": "string",
            "title": "Concept Id"
          },
          "style": {
            "type": "string",
            "title": "Style"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "targets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Targets",
            "default": []
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/Resource"
            },
            "type": "array",
            "title": "Resources",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "concept_id",
          "style",
          "explanation"
        ],
        "title": "Lesson"
      },
      "MasteryOut": {
        "properties": {
          "concepts": {
            "items": {
              "$ref": "#/components/schemas/ConceptState"
            },
            "type": "array",
            "title": "Concepts"
          },
          "misconceptions": {
            "items": {
              "$ref": "#/components/schemas/MisconceptionState"
            },
            "type": "array",
            "title": "Misconceptions"
          },
          "next_due": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
